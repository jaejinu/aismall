# Copy to .env.local only if it does not already exist. Never commit real secrets.
# See docs/SUPABASE_SETUP.md for project setup and distinct runtime/admin roles.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# App login: aismall_runtime (pooler username includes .PROJECT_REF).
# Use sslmode=verify-full; add sslrootcert if the provider CA is required.
DATABASE_URL=

# Migration only. Do not put this variable in the web runtime deployment.
DATABASE_ADMIN_URL=
